{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    { "type": "TextBlock", "text": "${tournament}", "size": "Small", "isSubtle": true, "wrap": true },
    { "type": "TextBlock", "text": "${status}", "size": "Small", "color": "Attention", "spacing": "None" },
    {
      "type": "ColumnSet",
      "columns": [
        { "type": "Column", "width": "stretch", "items": [{ "type": "TextBlock", "text": "${teamA}", "weight": "Bolder", "wrap": true }] },
        { "type": "Column", "width": "auto", "items": [{ "type": "TextBlock", "text": "${scoreA}", "size": "ExtraLarge", "weight": "Bolder", "color": "Accent" }] }
      ]
    },
    {
      "type": "ColumnSet", "spacing": "None",
      "columns": [
        { "type": "Column", "width": "stretch", "items": [{ "type": "TextBlock", "text": "${teamB}", "weight": "Bolder", "wrap": true }] },
        { "type": "Column", "width": "auto", "items": [{ "type": "TextBlock", "text": "${scoreB}", "size": "ExtraLarge", "weight": "Bolder", "color": "Warning" }] }
      ]
    },
    { "type": "TextBlock", "text": "${series}", "size": "Small", "isSubtle": true }
  ],
  "actions": [{ "type": "Action.Execute", "title": "Abrir", "verb": "open" }]
}
